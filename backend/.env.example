PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/operateos?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173

# Optional: leave GEMINI_API_KEY empty to use the built-in rule-based parser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated backups tried in order if the primary is overloaded or out of quota
# (run `node scripts/listModels.js` to see which models your key can use)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
